{
  "name": "tianguang",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Tianguang / Aubade - a new tab page built on the twelve shichen",
  "scripts": {
    "dev": "vite",
    "colors": "node scripts/gen-boot-colors.mjs",
    "build": "npm run colors && tsc --noEmit && vite build",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "icons": "node tools/icons.mjs",
    "store": "node tools/store.mjs",
    "shots": "node tools/shots.mjs",
    "loadcheck": "node tools/loadcheck.mjs",
    "pack": "npm run build && node tools/pack.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.2.7",
    "@types/node": "^26.4.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@preact/signals": "^2.11.1",
    "preact": "^10.29.8"
  }
}
